# Copy to .env and fill in. Never commit .env.
# Settrade Open API — https://developer.settrade.com/open-api/
# Sandbox: keep SETTRADE_BROKER_ID=SANDBOX (must be called from a Thai IP address)
SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_APP_CODE=
SETTRADE_BROKER_ID=SANDBOX



# SEC Thailand Open API key for mutual-fund NAV (free: api-portal.sec.or.th,
# subscribe to "Fund Daily Info"). Leave empty to skip FUND:* prices.
SEC_API_KEY=

# Poll interval (seconds) for Yahoo Finance / CoinGecko / gold
POLL_SEC=60
